# ─────────────────────────────────────────────
#  AI Educational Video Generation Platform
#  Environment Variables — copy to .env
# ─────────────────────────────────────────────

# ── Google AI ────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6JgRoIHlxSvi5bijRhmzI-HjNOll-THOBdkiobzqCK6vA
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.0-flash

# ── Firebase ─────────────────────────────────
# Enable Firebase for cloud persistence (set to false for local JSON development mode)
USE_FIREBASE=true
# Require valid Google Auth token on API requests
REQUIRE_AUTH=true
# Path to your Firebase service account JSON file (or provide raw JSON string in FIREBASE_CREDENTIALS_JSON for cloud hosting)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_CREDENTIALS_JSON=
# Your Firebase project ID
FIREBASE_PROJECT_ID=manimvideogeneration
# Firebase Storage bucket name (without gs://)
FIREBASE_STORAGE_BUCKET=manimvideogeneration.firebasestorage.app

# ── Application ───────────────────────────────
APP_NAME="AetherLearn.ai Platform"
APP_VERSION="1.0.0"
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rendering & Workers ──────────────────────
USE_BACKGROUND_WORKER=false    # Set to true when running separate worker.py on Render
E2B_API_KEY=                   # Optional: E2B API key to run Manim in isolated cloud sandbox
RENDER_OUTPUT_DIR=./renders
MANIM_QUALITY=low_quality      # low_quality | medium_quality | high_quality
MANIM_FORMAT=mp4

# ── Repair Agent ─────────────────────────────
MAX_REPAIR_RETRIES=3

# ── TTS ──────────────────────────────────────
TTS_ENGINE=edge-tts            # edge-tts | gtts
TTS_VOICE=en-US-AriaNeural     # edge-tts voice name
TTS_LANGUAGE=en                # gtts language code

# ── FFmpeg ───────────────────────────────────
# Leave empty to use system PATH
FFMPEG_BINARY=
