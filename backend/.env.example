# ─────────────────────────────────────────────
#  AI Educational Video Generation Platform
#  Environment Variables — copy to .env
# ─────────────────────────────────────────────

# ── Google AI ────────────────────────────────
GEMINI_API_KEY=AQ.Ab8RN6JgRoIHlxSvi5bijRhmzI-HjNOll-THOBdkiobzqCK6vA
GEMINI_MODEL=gemini-1.5-pro
GEMINI_FAST_MODEL=gemini-2.0-flash

# ── Firebase ─────────────────────────────────
# Path to your Firebase service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
# Your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id
# Firebase Storage bucket name (without gs://)
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.appspot.com

# ── Application ───────────────────────────────
APP_NAME="AetherLearn.ai Platform"
APP_VERSION="1.0.0"
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ── API ──────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Rendering ────────────────────────────────
# Absolute path to where rendered files are stored locally
RENDER_OUTPUT_DIR=./renders
MANIM_QUALITY=medium_quality   # low_quality | medium_quality | high_quality
MANIM_FORMAT=mp4

# ── Repair Agent ─────────────────────────────
MAX_REPAIR_RETRIES=3

# ── TTS ──────────────────────────────────────
TTS_ENGINE=edge-tts            # edge-tts | gtts
TTS_VOICE=en-US-AriaNeural     # edge-tts voice name
TTS_LANGUAGE=en                # gtts language code

# ── FFmpeg ───────────────────────────────────
# Leave empty to use system PATH
FFMPEG_BINARY=
